{
  "manifest_version": 3,
  "name": "Startpage Current Tab",
  "description": "Makes links on startpage.com open in the current tab instead of a new tab.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "startpage-current-tab@ycode.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.startpage.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}